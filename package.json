  "license": "MIT",
  "scripts": {
    "docker:start": "mkdir -p ./data/mysql && docker compose up -d --build",
    "docker:stop": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:clean": "docker compose down -v --remove-orphans --rmi all && docker volume prune -f && docker network prune -f",
    "docker:status": "docker compose ps",
    "docker:stats": "docker compose stats"
  },
  "private": true,
  "devDependencies": {
    "@nx/js": "21.5.1",
    "@nx/node": "^21.5.2",
    "@nx/workspace": "21.5.1",
    "@nxlv/python": "^21.2.0"
  }
}
